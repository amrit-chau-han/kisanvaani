graph TD
    %% Define Styles
    classDef ai fill:#4b2e83,color:#fff;
    classDef data fill:#8b3a2b,color:#fff;
    classDef io fill:#2e6400,color:#fff;
    classDef gen fill:#7a4a00,color:#fff;

    %% Flow
    Farmer((Farmer Voice Query)) --> UI[Cell 11: Gradio UI]
    UI --> STT[Cell 3: Whisper STT]
    STT --> Param[Cell 4: Parameter Extraction]
    Param --> TransEN[Cell 8: Translate to EN]
    
    Data[(Data Layer: AgMarkNet, Weather, Delta Lake)] --> Fetch[Cell 5: Fetch Data]
    TransEN --> Context[Cell 6: Context Assembly]
    Fetch --> Context
    
    Context --> Gen[Cell 7: Answer Generation]
    Gen --> TransNative[Cell 8: Translate to Native]
    
    TransNative --> Card[Answer Card]
    TransNative --> TTS[Cell 9: TTS Audio]
    
    Card -.-> Log[Cell 2: Delta Query Log]
    TTS -.-> Log

    %% Assign Classes
    class STT,Param,TransEN,TransNative ai;
    class Data,Fetch,Context data;
    class UI,Card,TTS io;
    class Gen gen;
